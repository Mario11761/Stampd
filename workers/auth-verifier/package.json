{
  "name": "stampd-auth-verifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run format:check && npm run deploy:dry-run",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260917.1",
    "@noble/curves": "1.9.7",
    "@types/node": "22.20.3",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.133.0"
  },
  "dependencies": {
    "@solana/wallet-standard-util": "1.1.4"
  }
}
