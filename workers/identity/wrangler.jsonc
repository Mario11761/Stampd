{
  "name": "stampd-identity",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "routes": [
    {
      "pattern": "identity.stampdpass.com",
      "custom_domain": true,
    },
  ],
}
